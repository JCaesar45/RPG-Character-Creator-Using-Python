body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background-color: #1a1a2e;
  color: #eee;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  margin: 0;
  padding: 20px;
}

.container {
  background-color: #16213e;
  border-radius: 10px;
  padding: 30px;
  box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
  max-width: 500px;
  width: 100%;
}

h1 {
  text-align: center;
  color: #e94560;
  margin-bottom: 25px;
}

.form-group {
  margin-bottom: 20px;
}

label {
  display: block;
  margin-bottom: 8px;
  font-weight: bold;
  color: #f5f5f5;
}

input {
  width: 100%;
  padding: 12px;
  border: 1px solid #0f3460;
  border-radius: 5px;
  background-color: #0f3460;
  color: #fff;
  font-size: 16px;
}

button {
  width: 100%;
  padding: 12px;
  background-color: #e94560;
  color: white;
  border: none;
  border-radius: 5px;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
  transition: background-color 0.3s;
}

button:hover {
  background-color: #c13651;
}

.result {
  margin-top: 25px;
  padding: 15px;
  background-color: #0f3460;
  border-radius: 5px;
  white-space: pre-line;
  font-family: 'Courier New', monospace;
  line-height: 1.6;
}

.error {
  color: #ff6b6b;
  font-weight: bold;
}
