<div class="container">
  <h1>RPG Character Creator</h1>
  <form id="character-form">
    <div class="form-group">
      <label for="name">Character Name:</label>
      <input type="text" id="name" required>
    </div>
    <div class="form-group">
      <label for="strength">Strength (1-4):</label>
      <input type="number" id="strength" min="1" max="4" required>
    </div>
    <div class="form-group">
      <label for="intelligence">Intelligence (1-4):</label>
      <input type="number" id="intelligence" min="1" max="4" required>
    </div>
    <div class="form-group">
      <label for="charisma">Charisma (1-4):</label>
      <input type="number" id="charisma" min="1" max="4" required>
    </div>
    <button type="submit">Create Character</button>
  </form>
  <div id="result" class="result"></div>
</div>
